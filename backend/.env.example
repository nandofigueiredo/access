# =============================================================================
# Backend — Portal TI Onboarding/Offboarding (FastAPI)
# =============================================================================

APP_NAME="Portal TI — Onboarding & Offboarding API"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# PostgreSQL (async SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://portal_ti:portal_ti@localhost:5432/portal_ti

# Microsoft Entra ID (Azure AD)
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Audiences aceitas (access_token Graph usa "00000003-0000-0000-c000-000000000000"
# ou api://<client-id>). Separe por vírgula se necessário.
AZURE_ALLOWED_AUDIENCES=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Domínios corporativos permitidos (vírgula)
CORPORATE_EMAIL_DOMAINS=diroma.com.br
ADMIN_EMAILS=luis.figueiredo@diroma.com.br

# CORS — origem do frontend Vite
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Somente DEV: pula validação JWT e usa usuário demo
AUTH_DISABLED=true
DEMO_USER_EMAIL=luis.figueiredo@diroma.com.br
DEMO_USER_NAME=Luis Figueiredo
DEMO_USER_ROLE=admin

# Redis
REDIS_URL=redis://localhost:6379/0

# GLPI API REST (abertura do chamado + nº na resposta)
GLPI_API_URL=https://glpi.diroma.com.br/apirest.php
GLPI_APP_TOKEN=
GLPI_API_USER=
GLPI_API_PASSWORD=
# Alternativa a user/senha: chave remota do usuário (Preferências → API)
GLPI_USER_TOKEN=
GLPI_ENTITY_ID=
GLPI_API_ENABLED=true
GLPI_EMAIL_FALLBACK=false

# GLPI MySQL (opcional — a API já grava o nº; deixe sync off se MySQL não liberar o host)
GLPI_DB_HOST=10.1.0.24
GLPI_DB_PORT=3306
GLPI_DB_USER=glpi_v11
GLPI_DB_PASSWORD=
GLPI_DB_NAME=glpi_prod_v11
GLPI_DB_SYNC_ENABLED=false
GLPI_DB_SYNC_INTERVAL_SEC=60

# Webhook GLPI (Power Automate — opcional)
# Header: X-Glpi-Webhook-Secret
GLPI_WEBHOOK_SECRET=
