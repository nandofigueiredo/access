# =============================================================================
# Access diRoma — copie para `.env` na raiz do clone e edite.
# =============================================================================

APP_ENV=production
DEBUG=false
AUTH_DISABLED=false

# Postgres QUE VOCÊ JÁ TEM (obrigatório)
# Use host da rede Docker: host.docker.internal (Docker Desktop)
# ou IP do servidor Postgres na LAN (ex.: 10.1.0.229)
DATABASE_URL=postgresql+asyncpg://USER:SENHA@10.1.0.229:5432/onboarding

# Redis do stack (nome do container na rede access_net)
REDIS_URL=redis://access-redis:6379/0

# URL pública (domínio do SEU nginx)
PUBLIC_URL=https://access.diroma.com.br
CORS_ORIGINS=https://access.diroma.com.br

# Portas no host (seu nginx faz proxy para elas)
# 8080=Vaultwarden · 8081=outro serviço PHP — use porta livre
WEB_PORT=5376
API_PORT=8000
REDIS_PORT=6379

# Entra ID
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_ALLOWED_AUDIENCES=
CORPORATE_EMAIL_DOMAINS=diroma.com.br
ADMIN_EMAILS=luis.figueiredo@diroma.com.br

# Build do frontend (redirect = URL pública do nginx)
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
VITE_AZURE_REDIRECT_URI=https://access.diroma.com.br
VITE_AZURE_API_SCOPE=
VITE_ENABLE_DEMO_LOGIN=false

# Só se for subir Postgres no Docker: docker compose --profile with-db up -d --build
POSTGRES_USER=portal_ti
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=portal_ti
POSTGRES_PORT=5432
