APP_ENV=production
DEBUG=false
AUTH_DISABLED=false

# Postgres
DATABASE_URL=postgresql+asyncpg://USER:SENHA@10.1.0.229:5432/onboarding

REDIS_URL=redis://access-redis:6379/0

PUBLIC_URL=https://access.diroma.com.br
CORS_ORIGINS=https://access.diroma.com.br

WEB_PORT=5376
API_PORT=8000
REDIS_PORT=6379

# Entra ID (API)
AZURE_TENANT_ID=b7cb56e2-6671-4189-a276-4a66ca27a691
AZURE_CLIENT_ID=c78656c2-538b-4db2-a5cc-49f149037a06
AZURE_ALLOWED_AUDIENCES=c78656c2-538b-4db2-a5cc-49f149037a06,api://c78656c2-538b-4db2-a5cc-49f149037a06
CORPORATE_EMAIL_DOMAINS=diroma.com.br
ADMIN_EMAILS=luis.figueiredo@diroma.com.br

# Build do frontend (obrigatório para login Microsoft real)
VITE_AZURE_CLIENT_ID=c78656c2-538b-4db2-a5cc-49f149037a06
VITE_AZURE_TENANT_ID=b7cb56e2-6671-4189-a276-4a66ca27a691
VITE_AZURE_REDIRECT_URI=https://access.diroma.com.br
# Vazio até "Expose an API" no Entra; se usar api://... sem isso → AADSTS500011 no login
VITE_AZURE_API_SCOPE=
VITE_ENABLE_DEMO_LOGIN=false

POSTGRES_USER=portal_ti
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=portal_ti
POSTGRES_PORT=5432
