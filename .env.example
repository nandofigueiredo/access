# =============================================================================
# Frontend — Portal TI (Vite + React + MSAL)
# =============================================================================

# URL da API FastAPI
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Microsoft Entra ID (mesmo App Registration do backend)
VITE_AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_AZURE_REDIRECT_URI=http://localhost:3000

# Scopes: User.Read obrigatório; se expor API própria use api://<client-id>/access_as_user
VITE_AZURE_API_SCOPE=api://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/access_as_user

# true = permite login demo sem Azure (dev)
VITE_ENABLE_DEMO_LOGIN=true
