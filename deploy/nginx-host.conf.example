# Exemplo para o NGINX que você já tem no servidor.
# Ajuste server_name e paths. Containers expõem:
#   web  → 127.0.0.1:8080
#   api  → 127.0.0.1:8000

upstream access_web {
    server 127.0.0.1:8080;
}

upstream access_api {
    server 127.0.0.1:8000;
}

server {
    listen 80;
    server_name access.diroma.com.br;   # ← troque

    # Frontend (container access-web)
    location / {
        proxy_pass http://access_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # API FastAPI
    location /api/ {
        proxy_pass http://access_api/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location = /health {
        proxy_pass http://access_api/health;
    }
}
