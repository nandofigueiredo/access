# Access diRoma — variáveis para docker compose / docker run
# Copie para .env na raiz do projeto antes de subir.

APP_ENV=production
DEBUG=false
AUTH_DISABLED=false

POSTGRES_USER=portal_ti
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=portal_ti
POSTGRES_PORT=5432

REDIS_PORT=6379

API_PORT=8000
WEB_PORT=8080

CORS_ORIGINS=http://SEU_SERVIDOR:8080,https://access.diroma.com.br

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_ALLOWED_AUDIENCES=
CORPORATE_EMAIL_DOMAINS=diroma.com.br
ADMIN_EMAILS=luis.figueiredo@diroma.com.br

VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
VITE_AZURE_REDIRECT_URI=http://SEU_SERVIDOR:8080
VITE_AZURE_API_SCOPE=
VITE_ENABLE_DEMO_LOGIN=false
VITE_AUTH_DEBUG=false

# Webhook GLPI (Power Automate) — opcional se GLPI_DB_* estiver ok
GLPI_WEBHOOK_SECRET=

# GLPI MySQL (leitura do nº do chamado)
GLPI_DB_HOST=10.1.0.24
GLPI_DB_PORT=3306
GLPI_DB_USER=glpi_v11
GLPI_DB_PASSWORD=
GLPI_DB_NAME=glpi_prod_v11
GLPI_DB_SYNC_ENABLED=true
GLPI_DB_SYNC_INTERVAL_SEC=60
