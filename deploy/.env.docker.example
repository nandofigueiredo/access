# Access diRoma — variáveis para docker compose / docker run
# Copie para .env na raiz do projeto antes de subir.

APP_ENV=production
DEBUG=false
AUTH_DISABLED=false

POSTGRES_USER=portal_ti
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=portal_ti
POSTGRES_PORT=5432

REDIS_PORT=6379

API_PORT=8000
WEB_PORT=8080

CORS_ORIGINS=http://SEU_SERVIDOR:8080,https://access.diroma.com.br

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_ALLOWED_AUDIENCES=
CORPORATE_EMAIL_DOMAINS=diroma.com.br
ADMIN_EMAILS=luis.figueiredo@diroma.com.br

VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
VITE_AZURE_REDIRECT_URI=http://SEU_SERVIDOR:8080
VITE_AZURE_API_SCOPE=
VITE_ENABLE_DEMO_LOGIN=false
